# Copy this file to .env and fill your own keys.
# cp .env.example .env

# ── Orchestrator (Groq) — https://console.groq.com/keys ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# ── Generator (Google AI Studio) — https://aistudio.google.com/apikey ──
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# ── Reranker (Cohere) — https://dashboard.cohere.com/api-keys ──
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-v3.5

# ── Optional legacy overrides (usually keep defaults in src/config.py) ──
# LLM_PROVIDER=groq
# OLLAMA_MODEL=qwen2.5:7b
# OPENAI_MODEL=gpt-4o
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# VLLM_BASE_URL=http://localhost:8000/v1
