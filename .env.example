# Copy this file to .env and fill your own keys.
# cp .env.example .env

# -- Orchestrator: Groq (default) --
ORCHESTRATOR_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# -- Optional Orchestrator: Google AI Studio instead of Groq --
# You can use a different Google account/project/key from the generator.
# ORCHESTRATOR_PROVIDER=google
# GOOGLE_ORCHESTRATOR_API_KEY=your_google_orchestrator_api_key_here
# GOOGLE_ORCHESTRATOR_MODEL=gemini-3.5-flash

# -- Generator: Google AI Studio --
GOOGLE_GENERATOR_API_KEY=your_google_generator_api_key_here
GOOGLE_GENERATOR_MODEL=gemini-3.5-flash

# Backward-compatible names also work:
# GOOGLE_API_KEY=your_google_generator_api_key_here
# GOOGLE_MODEL=gemini-3.5-flash

# -- Reranker: Cohere --
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-v4.0-pro

# -- Optional legacy overrides (usually keep defaults in src/config.py) --
MAX_CPU_CORES=12
EMBED_BATCH_SIZE=8

# -- Speed/quality knobs --
# Lower values are faster and cheaper; raise them if recall or answer completeness drops.
TOP_K_RETRIEVE=30
TOP_K_RERANK=10
MAX_SEARCH_QUERIES=4
EXACT_LOOKUP_SHORT_CIRCUIT=true
MAX_CONTEXT_ARTICLES=6
MAX_REFERENCE_ARTICLES=2
MAX_ARTICLE_CHARS=4000
MAX_CONTEXT_CHARS=18000

# LLM_PROVIDER=groq
# OLLAMA_MODEL=qwen2.5:7b
# OPENAI_MODEL=gpt-4o
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# VLLM_BASE_URL=http://localhost:8000/v1
